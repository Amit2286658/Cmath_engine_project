# =============================================================================
# lib/00_bootstrap.math — Minimal Bootstrap Subset Hooked First by the C Core
# =============================================================================
# Without this file, the engine does not know what parentheses `(` `)`, commas
# `,`, struct member access `.`, numbers, strings, semicolons `;`, variable
# assignments `:=` / `=`, loops `??`, or `if` branches are.
# The C core loads this file first so subsequent `.math` files can use them.

[boot_syntax]

# 1. Expression Grouping & Argument Delimiters (`=> @lparen / @rparen / @comma`)
"(" => @lparen
")" => @rparen
"," => @comma


[boot_types]
<[boot_syntax]

# 2. Consuming Lexical Types (`$` + `@` parser intrinsics)
$real ~ \d+ ("." \d+)?       => @f64
$iota ~ \d+ ("." \d+)? "i"   => @f64_trim1
$str  ~ "\"" [^"]* "\""      => @str_slice


[boot_control]
<[boot_syntax]
<[boot_types]

# 3. Struct Member Access Operator `.` (Left-associative infix, precedence 95)
(s:real) "." (f:real) :<95 -> real = @field(s, f)

# 4. Multi-Instruction Sequencing `;` (Left-associative infix, precedence 1)
#    Allows any parenthesized expression `( stmt1 ; stmt2 ; final_expr )`
#    to act as a multi-instruction block!
(a:real) ";" (b:real) :<1 -> real = @seq(a, b)

# 5. Local Variable & Struct Field Assignment (`:=` and `=`, right-assoc prec 5)
(target:real) ":=" (val:real) :>5 -> real = @store(target, val)
(target:real) "="  (val:real) :>5 -> real = @store(target, val)

# 6. Lazy While Loop Operator `??` (Left-associative infix, precedence 3)
#    Usage: `(cond) ?? ( stmt1 ; stmt2 )`
(cond:real) "??" (body:real) :<3 -> real = @while(cond, body)

# 7. Lazy Conditional Branch Function `if(cond, then_expr, else_expr)`
"if"(cond:real, then_val:real, else_val:real) -> real = @if(cond, then_val, else_val)
