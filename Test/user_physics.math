# =============================================================================
# Test/user_physics.math — User Extension Hooked via In-Memory `user_loader.h`
# =============================================================================
# Demonstrates:
#   1. Calling standard library modules (`[arith]`, `[trig]`, `[geom_ext]`,
#      `[algebra]`, `[units]`, `[physics]`, `[chemistry]`)
#   2. Wrapping host-registered C callbacks (`eng_register_extern`) for:
#      - `@fx_rate(from, to)`         : Realtime currency exchange rate
#      - `@fx_history(from, to, days)`: Vector-returning historical FX series
#      - `@kv_set(key, val)` / `@kv_get(key)` : Persistent host key-value store
#      - `@elem_mass(symbol)`         : IUPAC Periodic Table atomic mass lookup
#   3. Defining custom applied engineering & rocket propulsion functions

[user_physics]
<[boot_syntax]
<[boot_types]
<[boot_control]
<[arith]
<[trig]
<[geom_ext]
<[algebra]
<[units]
<[physics]
<[chemistry]

# 1. Applied Aerospace & Fluid Engineering Functions
#    Tsiolkovsky Rocket Equation: dV = Isp * g0 * ln(m0 / mf)
"rocket_dv"(isp_s:real, m0_kg:real, mf_kg:real) -> real =
    isp_s * g0 * ln(m0_kg / mf_kg)

#    Acoustic / RF Free-Space Path Loss (linear ratio from distance & wavelength)
"fspl_ratio"(dist_m:real, lambda_m:real) -> real =
    ((4 * π * dist_m) / lambda_m) ^ 2

# 2. Host-Backed Realtime Currency Conversion (`@fx_rate`)
"fx_rate"(from:str, to:str) -> real = @fx_rate(from, to)
"convert_fx"(amount:real, from:str, to:str) -> real = amount * @fx_rate(from, to)
(usd:real) "to_inr" :90 -> real = usd * @fx_rate("USD", "INR")
(eur:real) "to_usd" :90 -> real = eur * @fx_rate("EUR", "USD")
"vec_sum_fx"(prices_usd:vec, target_ccy:str) -> real =
    vec_sum(prices_usd) * @fx_rate("USD", target_ccy)

# 3. Host-Backed Vector-Returning Time Series (`@fx_history` -> `$vec`)
"fx_history"(from:str, to:str, days:real) -> vec = @fx_history(from, to, days)
"fx_sma"(from:str, to:str, days:real, window:real) -> real =
    sma(@fx_history(from, to, days), window)

# 4. Host-Backed Persistent Key-Value Store (`@kv_set`, `@kv_get`)
"save_var"(key:str, val:real) -> real = @kv_set(key, val)
"load_var"(key:str)           -> real = @kv_get(key)

# 5. Host-Backed Periodic Table Atomic Mass Lookup (`@elem_mass`)
"elem"(sym:str)          -> real = @elem_mass(sym)
"molar_mass_h2o"()       -> real = 2 * @elem_mass("H")  + @elem_mass("O")
"molar_mass_co2"()       -> real = @elem_mass("C")      + 2 * @elem_mass("O")
"molar_mass_nacl"()      -> real = @elem_mass("Na")     + @elem_mass("Cl")
"molar_mass_glucose"()   -> real =
    6 * @elem_mass("C") + 12 * @elem_mass("H") + 6 * @elem_mass("O")
