# =============================================================================
# Library/30_complex.math — Postfix `i` ($iota) Operator & Complex Operations
# =============================================================================

[complex_ext]
<[arith]
<[trig]

# Non-consuming struct type (constructed only via operations)
$complex(re:real, im:real)

# Postfix imaginary operator `i` (precedence 95: binds tighter than `^`, `*`, `-`)
# Works on literals (`5i`, `3.14i`), parenthesized expressions (`(3 + 4)i`),
# function calls (`sin(π / 2)i`), `iota` (`(5i)i` -> `-5`), and `complex`!
(x:real)    "i" :95 -> iota    = @raw(x)
(x:iota)    "i" :95 -> real    = -@raw(x)
(z:complex) "i" :95 -> complex = complex(-z.im, z.re)

# Unary & binary arithmetic on `iota`
"-" (a:iota)               :80  -> iota = @neg(a)
(a:iota) "+" (b:iota)      :<50 -> iota = @add(a, b)
(a:iota) "-" (b:iota)      :<50 -> iota = @sub(a, b)
(a:iota) "*" (b:iota)      :<60 -> real = -(@mul(a, b))
(a:real) "*" (b:iota)      :<60 -> iota = @mul(a, b)
(a:iota) "*" (b:real)      :<60 -> iota = @mul(a, b)

# Constructing `complex` from `real` and `iota` (`1 + 1i`, `3 - 4i`, `(3 + 4)i + 2`)
(a:real) "+" (b:iota)      :<50 -> complex = complex(a, @raw(b))
(a:real) "-" (b:iota)      :<50 -> complex = complex(a, -@raw(b))
(a:iota) "+" (b:real)      :<50 -> complex = complex(b, @raw(a))
(a:iota) "-" (b:real)      :<50 -> complex = complex(-b, @raw(a))
(z:complex) "+" (b:iota)   :<50 -> complex = complex(z.re, z.im + @raw(b))
(z:complex) "-" (b:iota)   :<50 -> complex = complex(z.re, z.im - @raw(b))

# Overloaded arithmetic on `complex` numbers
(a:complex) "+" (b:complex) :<50 -> complex = complex(a.re + b.re, a.im + b.im)
(a:complex) "-" (b:complex) :<50 -> complex = complex(a.re - b.re, a.im - b.im)
(a:complex) "*" (b:complex) :<60 -> complex =
    complex(a.re * b.re - a.im * b.im, a.re * b.im + a.im * b.re)
(a:complex) "/" (b:complex) :<60 -> complex = (
    denom := b.re^2 + b.im^2;
    complex((a.re * b.re + a.im * b.im) / denom,
            (a.im * b.re - a.re * b.im) / denom)
)

"conj"(z:complex)   -> complex = complex(z.re, -z.im)
"cabs"(z:complex)   -> real    = √(z.re^2 + z.im^2)
"carg"(z:complex)   -> real    = atan2(z.im, z.re)
"cexp_i"(theta:real)-> complex = complex(cos(theta), sin(theta))
"polar"(r:real, theta:real) -> complex = complex(r * cos(theta), r * sin(theta))
