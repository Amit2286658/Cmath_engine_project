# =============================================================================
# Library/80_chemistry.math — High School & Physical Chemistry Numerical Suite
# =============================================================================

[chemistry]
<[arith]
<[trig]
<[units]

# 1. Fundamental Chemical & Thermodynamic Constants
"N_A"         : real = 6.02214076 * (10 ^ 23)        # Avogadro constant (mol^-1)
"R_gas"       : real = 8.314462618                   # Universal gas constant (J mol^-1 K^-1)
"R_atm"       : real = 0.082057366                   # Gas constant in (L atm mol^-1 K^-1)
"F_faraday"   : real = 96485.33212                   # Faraday constant (C/mol)
"T_stp"       : real = 273.15                        # Standard temperature (K)
"P_stp"       : real = 101325                        # Standard pressure (Pa = 1 atm)
"kw_water"    : real = 10 ^ -14                      # Autoionization constant of water at 25 C

# 2. Stoichiometry, Empirical Composition, Solutions & Concentration Units
"moles"(mass_g:real, molar_mass:real)           -> real = mass_g / molar_mass
"mass_from_moles"(n_mol:real, molar_mass:real)  -> real = n_mol * molar_mass
"particles_from_moles"(n_mol:real)              -> real = n_mol * N_A
"percent_composition"(mass_elem:real, molar_mass:real) -> real =
    (mass_elem / molar_mass) * 100
"percent_yield"(actual_y:real, theor_y:real)    -> real = (actual_y / theor_y) * 100
"atom_economy"(mw_desired:real, mw_reactants:real) -> real =
    (mw_desired / mw_reactants) * 100

"molarity"(n_mol:real, vol_liters:real)         -> real = n_mol / vol_liters
"normality_from_molarity"(molarity_m:real, n_factor:real) -> real =
    molarity_m * n_factor
"dilution_v1"(c1:real, c2:real, v2:real)        -> real = (c2 * v2) / c1
"molality"(n_solute:real, kg_solvent:real)      -> real = n_solute / kg_solvent
"mole_fraction"(n_component:real, n_total:real) -> real = n_component / n_total
"ppm_conc"(mass_solute_g:real, mass_soln_g:real)-> real =
    (mass_solute_g / mass_soln_g) * (10 ^ 6)

# 3. Colligative Properties of Solutions (Raoult, Boiling/Freezing Shift, Van t Hoff)
"raoult_p_soln"(x_solvent:real, p0_solvent:real) -> real = x_solvent * p0_solvent
"bp_elevation"(i_vant:real, kb:real, molality_m:real) -> real = i_vant * kb * molality_m
"fp_depression"(i_vant:real, kf:real, molality_m:real)-> real = i_vant * kf * molality_m
"osmotic_pressure"(molarity_m:real, temp_k:real) -> real = molarity_m * R_atm * temp_k
"vant_hoff_osmotic"(i_vant:real, molarity_m:real, temp_k:real) -> real =
    i_vant * molarity_m * R_atm * temp_k

# 4. Gas Laws (Boyle, Charles, Combined, Ideal, Dalton, Van der Waals & Graham)
"boyle_p2"(p1:real, v1:real, v2:real)            -> real = (p1 * v1) / v2
"charles_v2"(v1:real, t1_k:real, t2_k:real)      -> real = (v1 * t2_k) / t1_k
"combined_gas_v2"(p1:real, v1:real, t1_k:real, p2:real, t2_k:real) -> real =
    (p1 * v1 * t2_k) / (p2 * t1_k)
"dalton_partial_p"(mole_frac:real, p_total:real) -> real = mole_frac * p_total

"ideal_gas_p"(n_mol:real, temp_k:real, vol_m3:real)  -> real = (n_mol * R_gas * temp_k) / vol_m3
"ideal_gas_v"(n_mol:real, temp_k:real, press_pa:real)-> real = (n_mol * R_gas * temp_k) / press_pa
"ideal_gas_n"(press_pa:real, vol_m3:real, temp_k:real)-> real = (press_pa * vol_m3) / (R_gas * temp_k)
"ideal_gas_t"(press_pa:real, vol_m3:real, n_mol:real)-> real = (press_pa * vol_m3) / (n_mol * R_gas)
"van_der_waals_p"(n_mol:real, temp_k:real, vol_l:real, a_vdw:real, b_vdw:real) -> real =
    ((n_mol * R_atm * temp_k) / (vol_l - n_mol * b_vdw)) - a_vdw * ((n_mol / vol_l) ^ 2)

"rms_mol_speed"(temp_k:real, molar_mass_kg:real) -> real = √(3 * R_gas * temp_k / molar_mass_kg)
"graham_rate_ratio"(molar_mass1:real, molar_mass2:real) -> real = √(molar_mass2 / molar_mass1)

# 5. Acid-Base Chemistry, Weak Acids, Buffers & Solubility Product (Ksp)
"ph_from_h"(h_conc:real)   -> real = -log10(h_conc)
"h_from_ph"(ph_val:real)   -> real = 10 ^ (-ph_val)
"poh_from_oh"(oh_conc:real)-> real = -log10(oh_conc)
"oh_from_poh"(poh_val:real)-> real = 10 ^ (-poh_val)
"poh_from_ph"(ph_val:real) -> real = 14 - ph_val
"ph_from_poh"(poh_val:real)-> real = 14 - poh_val
"ph_from_oh"(oh_conc:real) -> real = 14 - (-log10(oh_conc))

"pka_from_ka"(ka:real)     -> real = -log10(ka)
"ka_from_pka"(pka:real)    -> real = 10 ^ (-pka)
"weak_acid_h"(ka:real, conc_c:real)  -> real = √(ka * conc_c)
"weak_acid_ph"(ka:real, conc_c:real) -> real = -log10(√(ka * conc_c))
"henderson_hasselbalch"(pka:real, conj_base:real, weak_acid:real) -> real =
    pka + log10(conj_base / weak_acid)
"solubility_ksp_ab"(ksp:real)  -> real = √(ksp)
"solubility_ksp_ab2"(ksp:real) -> real = (ksp / 4) ^ (1 / 3)

# 6. Chemical Kinetics, Nuclear Decay, Thermochemistry, Electrochemistry & Solid State
"arrhenius_k"(pre_exp_a:real, ea_j_mol:real, temp_k:real) -> real =
    pre_exp_a * exp(-ea_j_mol / (R_gas * temp_k))
"arrhenius_k2"(k1:real, ea_j_mol:real, t1_k:real, t2_k:real) -> real =
    k1 * exp((ea_j_mol / R_gas) * ((1 / t1_k) - (1 / t2_k)))

"rate_const_1st"(t_sec:real, c0:real, ct:real)  -> real = (1 / t_sec) * ln(c0 / ct)
"half_life_1st"(rate_k:real)                    -> real = ln(2) / rate_k
"zero_order_half_life"(c0:real, rate_k:real)    -> real = c0 / (2 * rate_k)
"second_order_half_life"(c0:real, rate_k:real)  -> real = 1 / (rate_k * c0)
"decay_rem"(n0:real, time_t:real, half_life:real) -> real =
    n0 * (0.5 ^ (time_t / half_life))
"radiocarbon_age"(fraction_rem:real) -> real =
    -5730 * (ln(fraction_rem) / ln(2))

"enthalpy_rxn"(sum_h_prod:real, sum_h_react:real) -> real = sum_h_prod - sum_h_react
"kp_from_kc"(kc:real, temp_k:real, delta_n_gas:real) -> real =
    kc * ((R_atm * temp_k) ^ delta_n_gas)
"gibbs_free_energy"(dh_j:real, temp_k:real, ds_j_k:real) -> real =
    dh_j - temp_k * ds_j_k
"gibbs_from_keq"(temp_k:real, keq:real) -> real =
    -R_gas * temp_k * ln(keq)

"cell_emf"(e_cathode:real, e_anode:real) -> real = e_cathode - e_anode
"gibbs_electro"(n_elec:real, e_cell_v:real) -> real = -n_elec * F_faraday * e_cell_v
"faraday_mass"(current_i:real, time_s:real, molar_mass:real, n_elec:real) -> real =
    (current_i * time_s * molar_mass) / (n_elec * F_faraday)
"molar_conductivity"(kappa_s_cm:real, molarity_m:real) -> real =
    (kappa_s_cm * 1000) / molarity_m
"nernst_cell"(e0_volts:real, n_elec:real, reaction_q:real) -> real =
    e0_volts - (R_gas * 298.15 / (n_elec * F_faraday)) * ln(reaction_q)

"crystal_density"(z_atoms:real, molar_mass:real, a_edge_cm:real) -> real =
    (z_atoms * molar_mass) / ((a_edge_cm ^ 3) * N_A)
"bragg_d_spacing"(n_order:real, wavelength:real, theta_deg:real) -> real =
    (n_order * wavelength) / (2 * sin(deg2rad(theta_deg)))
