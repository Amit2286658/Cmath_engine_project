# =============================================================================
# Library/trig.math — Trigonometric, Hyperbolic & Transcendental Functions
# =============================================================================

[trig]
<[arith]

# 1. Circular Trigonometric Functions (radians)
sin(x) = @sin(x)
cos(x) = @cos(x)
tan(x) = @tan(x)
sec(x) = 1 / @cos(x)
csc(x) = 1 / @sin(x)
cot(x) = @cos(x) / @sin(x)

# 2. Inverse Circular Trigonometric Functions
asin(x)     = @asin(x)
acos(x)     = @acos(x)
atan(x)     = @atan(x)
atan2(y, x) = @atan2(y, x)

# 3. Hyperbolic & Inverse Hyperbolic Functions
sinh(x)  = @sinh(x)
cosh(x)  = @cosh(x)
tanh(x)  = @tanh(x)
asinh(x) = @ln(x + √(x^2 + 1))
acosh(x) = @ln(x + √(x^2 - 1))
atanh(x) = 0.5 * @ln((1 + x) / (1 - x))

# 4. Exponential, Logarithmic & Root Functions
ln(x)         = @ln(x)
log10(x)      = @log10(x)
log2(x)       = @ln(x) / @ln(2)
logb(x, base) = @ln(x) / @ln(base)
exp(x)        = @exp(x)
sqrt(x)       = @sqrt(x)
cbrt(x)       = @cbrt(x)
root(x, n)    = x ^ (1 / n)
hypot(a, b)   = √(a^2 + b^2)
sigmoid(x)    = 1 / (1 + @exp(-x))
