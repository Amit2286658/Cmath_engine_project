# =============================================================================
# Library/70_physics.math — High School & University Physics Numerical Suite
# =============================================================================

[physics]
<[arith]
<[trig]
<[geom_ext]
<[units]

# 1. Fundamental CODATA Physical Constants (SI Units)
"g0"         : real = 9.80665                        # Standard gravity (m/s^2)
"c0"         : real = 299792458                      # Speed of light in vacuum (m/s)
"G_grav"     : real = 6.67430 * (10 ^ -11)           # Gravitational constant (m^3 kg^-1 s^-2)
"h_planck"   : real = 6.62607015 * (10 ^ -34)        # Planck constant (J s)
"k_B"        : real = 1.380649 * (10 ^ -23)          # Boltzmann constant (J/K)
"ke_coulomb" : real = 8.9875517923 * (10 ^ 9)        # Coulomb constant 1/(4*pi*eps0) (N m^2/C^2)
"eps0"       : real = 8.8541878128 * (10 ^ -12)      # Vacuum permittivity (F/m)
"mu0"        : real = 1.25663706212 * (10 ^ -6)      # Vacuum permeability (H/m)
"q_e"        : real = 1.602176634 * (10 ^ -19)       # Elementary charge (C)
"m_e"        : real = 9.1093837015 * (10 ^ -31)      # Electron mass (kg)
"m_p"        : real = 1.67262192369 * (10 ^ -27)     # Proton mass (kg)
"sigma_sb"   : real = 5.670374419 * (10 ^ -8)        # Stefan-Boltzmann constant (W m^-2 K^-4)
"b_wien"     : real = 2.897771955 * (10 ^ -3)        # Wien displacement constant (m K)
"rydberg_R"  : real = 10973731.56816                 # Rydberg constant (m^-1)

# 2. High School Kinematics (SUVAT Equations & Projectile Motion)
"suvat_v"(u:real, a:real, t:real)      -> real = u + a * t
"suvat_s"(u:real, a:real, t:real)      -> real = u * t + 0.5 * a * (t ^ 2)
"suvat_v2"(u:real, a:real, s:real)     -> real = √((u ^ 2) + 2 * a * s)
"suvat_s_avg"(u:real, v:real, t:real)  -> real = 0.5 * (u + v) * t
"suvat_nth_sec"(u:real, a:real, n:real)-> real = u + 0.5 * a * (2 * n - 1)

"ke"(mass:real, vel:real) -> real = 0.5 * mass * (vel ^ 2)
"pe"(mass:real, height:real) -> real = mass * g0 * height
"mech_energy"(mass:real, vel:real, height:real) -> real =
    ke(mass, vel) + pe(mass, height)

"proj_range"(vel:real, angle_deg:real) -> real =
    (vel ^ 2) * sin(2 * deg2rad(angle_deg)) / g0
"proj_max_h"(vel:real, angle_deg:real) -> real =
    ((vel * sin(deg2rad(angle_deg))) ^ 2) / (2 * g0)
"proj_time"(vel:real, angle_deg:real) -> real =
    2 * vel * sin(deg2rad(angle_deg)) / g0

# 3. Laws of Motion, Friction, Momentum, Impulse & 1D Collisions
"momentum"(mass:real, vel:real)          -> real = mass * vel
"impulse"(force_f:real, dt:real)         -> real = force_f * dt
"recoil_vel"(m_gun:real, m_bullet:real, v_bullet:real) -> real =
    -(m_bullet * v_bullet) / m_gun
"friction_force"(mu:real, normal_n:real) -> real = mu * normal_n
"incline_normal"(mass:real, theta_deg:real) -> real =
    mass * g0 * cos(deg2rad(theta_deg))
"incline_slide_acc"(theta_deg:real, mu_k:real) -> real =
    g0 * (sin(deg2rad(theta_deg)) - mu_k * cos(deg2rad(theta_deg)))
"banking_angle_deg"(vel:real, r:real) -> real =
    rad2deg(atan((vel ^ 2) / (r * g0)))

"elastic_v1"(m1:real, u1:real, m2:real, u2:real) -> real =
    ((m1 - m2) * u1 + 2 * m2 * u2) / (m1 + m2)
"elastic_v2"(m1:real, u1:real, m2:real, u2:real) -> real =
    ((m2 - m1) * u2 + 2 * m1 * u1) / (m1 + m2)
"inelastic_v"(m1:real, u1:real, m2:real, u2:real) -> real =
    (m1 * u1 + m2 * u2) / (m1 + m2)

# 4. Circular Motion, Rotational Mechanics & Simple Harmonic Motion (SHM)
"centripetal_acc"(vel:real, r:real) -> real = (vel ^ 2) / r
"centripetal_force"(mass:real, vel:real, r:real) -> real = mass * (vel ^ 2) / r
"torque_val"(r:real, force_f:real, theta_deg:real) -> real =
    r * force_f * sin(deg2rad(theta_deg))
"ang_momentum"(inertia_i:real, omega:real) -> real = inertia_i * omega
"rot_ke"(inertia_i:real, omega:real)       -> real = 0.5 * inertia_i * (omega ^ 2)

"hooke_force"(k_spring:real, disp:real) -> real = -k_spring * disp
"elastic_pe"(k_spring:real, disp:real)  -> real = 0.5 * k_spring * (disp ^ 2)
"pendulum_period"(length_m:real)        -> real = 2 * π * √(length_m / g0)
"shm_omega"(k_spring:real, mass:real)   -> real = √(k_spring / mass)
"shm_period_spring"(mass:real, k_spring:real) -> real = 2 * π * √(mass / k_spring)
"shm_vel"(omega:real, amp_a:real, disp_x:real)-> real = omega * √((amp_a ^ 2) - (disp_x ^ 2))
"shm_acc"(omega:real, disp_x:real)      -> real = -(omega ^ 2) * disp_x

# 5. Gravitation & Orbital Astrophysics
"grav_force"(m1:real, m2:real, r:real) -> real = G_grav * m1 * m2 / (r ^ 2)
"grav_pe"(m1:real, m2:real, r:real)    -> real = -G_grav * m1 * m2 / r
"orbital_vel"(mass_body:real, r:real)  -> real = √(G_grav * mass_body / r)
"escape_vel"(mass_body:real, r:real)   -> real = √(2 * G_grav * mass_body / r)
"schwarzschild_r"(mass_body:real)      -> real = 2 * G_grav * mass_body / (c0 ^ 2)
"kepler_period"(semi_major_a:real, mass_body:real) -> real =
    2 * π * √((semi_major_a ^ 3) / (G_grav * mass_body))

# 6. Fluid Mechanics, Elasticity & Surface Tension
"hydro_pressure"(rho:real, depth_h:real) -> real = rho * g0 * depth_h
"buoyant_force"(rho_fluid:real, vol_sub:real) -> real = rho_fluid * g0 * vol_sub
"continuity_v2"(a1:real, v1:real, a2:real) -> real = (a1 * v1) / a2
"stokes_drag"(eta:real, r:real, vel:real) -> real = 6 * π * eta * r * vel
"terminal_vel"(r:real, rho_sphere:real, rho_fluid:real, eta:real) -> real =
    (2 * (r ^ 2) * (rho_sphere - rho_fluid) * g0) / (9 * eta)
"stress_val"(force_f:real, area:real) -> real = force_f / area
"strain_val"(dl:real, l0:real)        -> real = dl / l0
"youngs_modulus"(force_f:real, l0:real, area:real, dl:real) -> real =
    (force_f * l0) / (area * dl)

# 7. Thermodynamics, Calorimetry & Heat Transfer
"sensible_heat"(mass:real, c_spec:real, dt:real) -> real = mass * c_spec * dt
"latent_heat"(mass:real, l_spec:real)            -> real = mass * l_spec
"thermal_expansion_l"(l0:real, alpha:real, dt:real) -> real = l0 * (1 + alpha * dt)
"thermal_cond_rate"(k_cond:real, area:real, dt:real, thickness:real) -> real =
    (k_cond * area * dt) / thickness
"wien_peak_lambda"(temp_k:real) -> real = b_wien / temp_k
"stefan_boltzmann_p"(area:real, emissivity:real, temp_k:real) -> real =
    area * emissivity * sigma_sb * (temp_k ^ 4)
"carnot_eff"(t_cold_k:real, t_hot_k:real) -> real = 1 - (t_cold_k / t_hot_k)

# 8. Electromagnetism, DC/AC Circuits & Transformers
"coulomb_force"(q1:real, q2:real, r:real) -> real = ke_coulomb * q1 * q2 / (r ^ 2)
"ohm_v"(current_i:real, res_r:real) -> real = current_i * res_r
"ohm_i"(volt_v:real, res_r:real)    -> real = volt_v / res_r
"ohm_r"(volt_v:real, current_i:real)-> real = volt_v / current_i
"elec_power"(volt_v:real, current_i:real) -> real = volt_v * current_i
"cap_energy"(cap_c:real, volt_v:real)     -> real = 0.5 * cap_c * (volt_v ^ 2)
"ind_energy"(ind_l:real, current_i:real)  -> real = 0.5 * ind_l * (current_i ^ 2)
"res_series"(r1:real, r2:real)   -> real = r1 + r2
"res_parallel"(r1:real, r2:real) -> real = (r1 * r2) / (r1 + r2)
"cap_series"(c1:real, c2:real)   -> real = (c1 * c2) / (c1 + c2)
"cap_parallel"(c1:real, c2:real) -> real = c1 + c2
"parallel_plate_cap"(area:real, sep_d:real) -> real = eps0 * area / sep_d
"rc_tau"(res_r:real, cap_c:real) -> real = res_r * cap_c
"wheatstone_r4"(r1:real, r2:real, r3:real) -> real = (r2 * r3) / r1
"drift_velocity"(current_i:real, n_density:real, area:real, q_charge:real) -> real =
    current_i / (n_density * area * q_charge)

"lorentz_mag_force"(q:real, vel:real, b_field:real, theta_deg:real) -> real =
    q * vel * b_field * sin(deg2rad(theta_deg))
"cyclotron_radius"(mass:real, vel:real, q:real, b_field:real) -> real =
    (mass * vel) / (q * b_field)
"solenoid_b"(n_turns_per_m:real, current_i:real) -> real =
    mu0 * n_turns_per_m * current_i
"inductive_reactance"(freq_hz:real, ind_l:real)  -> real = 2 * π * freq_hz * ind_l
"capacitive_reactance"(freq_hz:real, cap_c:real) -> real = 1 / (2 * π * freq_hz * cap_c)
"rlc_impedance"(res_r:real, xl:real, xc:real)    -> real = √((res_r ^ 2) + ((xl - xc) ^ 2))
"rlc_resonant_freq"(ind_l:real, cap_c:real)      -> real = 1 / (2 * π * √(ind_l * cap_c))
"transformer_v2"(v1:real, n1:real, n2:real)      -> real = v1 * (n2 / n1)

# 9. Waves, Acoustics, Geometrical/Wave Optics, Quantum & Special Relativity
"doppler_freq"(f0:real, v_sound:real, v_obs:real, v_src:real) -> real =
    f0 * ((v_sound + v_obs) / (v_sound - v_src))
"beat_freq"(f1:real, f2:real) -> real = @abs(f1 - f2)
"sound_db"(intensity_i:real)  -> real = 10 * log10(intensity_i / (10 ^ -12))

"snell_angle2"(n1:real, theta1_deg:real, n2:real) -> real =
    rad2deg(asin(n1 * sin(deg2rad(theta1_deg)) / n2))
"lens_focal"(do_dist:real, di_dist:real) -> real =
    (do_dist * di_dist) / (do_dist + di_dist)
"mirror_image_v"(f_len:real, u_obj:real) -> real =
    (f_len * u_obj) / (u_obj - f_len)
"magnification_lens"(v_img:real, u_obj:real) -> real = v_img / u_obj
"lens_power_dioptre"(f_meters:real) -> real = 1 / f_meters
"young_fringe_width"(wavelength_m:real, screen_d:real, slit_sep_d:real) -> real =
    (wavelength_m * screen_d) / slit_sep_d
"malus_law"(i0:real, theta_deg:real) -> real = i0 * (cos(deg2rad(theta_deg)) ^ 2)
"brewster_angle"(n1:real, n2:real)   -> real = rad2deg(atan(n2 / n1))

"photon_energy"(freq_hz:real)          -> real = h_planck * freq_hz
"photon_wavelength"(wavelength_m:real) -> real = h_planck * c0 / wavelength_m
"photoelectric_ke_max"(freq_hz:real, work_fn_j:real) -> real =
    h_planck * freq_hz - work_fn_j
"de_broglie"(mass:real, vel:real)      -> real = h_planck / (mass * vel)
"bohr_radius_n"(n_orbit:real)          -> real = 5.29177210903 * (10 ^ -11) * (n_orbit ^ 2)
"bohr_energy_ev"(n_orbit:real, z_atomic:real) -> real =
    -13.6 * ((z_atomic ^ 2) / (n_orbit ^ 2))
"rydberg_wavelength"(n1:real, n2:real) -> real =
    1 / (rydberg_R * ((1 / (n1 ^ 2)) - (1 / (n2 ^ 2))))

"lorentz_gamma"(vel:real) -> real = 1 / √(1 - (vel / c0) ^ 2)
"rel_energy"(mass:real, vel:real) -> real = lorentz_gamma(vel) * mass * (c0 ^ 2)
"time_dilation"(t_proper:real, vel:real) -> real = t_proper * lorentz_gamma(vel)
"length_contraction"(l_proper:real, vel:real) -> real = l_proper / lorentz_gamma(vel)
