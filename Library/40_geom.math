# =============================================================================
# Library/40_geom.math — 2D/3D Vectors (`$vec2`, `$vec3`) & Geometric Shapes
# =============================================================================

[geom_ext]
<[arith]
<[trig]

# 1. Flat C-Style Structs (`$vec2`, `$vec3`, Nested `$circle`)
$vec2(x:real, y:real)
$vec3(x:real, y:real, z:real)
$circle(center:vec2, radius:real)

# 2. 2D Vector Operations
(a:vec2) "+" (b:vec2) :<50 -> vec2 = vec2(a.x + b.x, a.y + b.y)
(a:vec2) "-" (b:vec2) :<50 -> vec2 = vec2(a.x - b.x, a.y - b.y)
(s:real) "*" (v:vec2) :<60 -> vec2 = vec2(s * v.x, s * v.y)
(v:vec2) "*" (s:real) :<60 -> vec2 = vec2(v.x * s, v.y * s)

"dot"(a:vec2, b:vec2)       -> real = a.x * b.x + a.y * b.y
"cross2"(a:vec2, b:vec2)    -> real = a.x * b.y - a.y * b.x
"vec2_mag"(v:vec2)          -> real = hypot(v.x, v.y)
"vec2_dist"(a:vec2, b:vec2) -> real = hypot(b.x - a.x, b.y - a.y)

# 3. 3D Vector Operations & `**` Dot Product Operator
(a:vec3) "+"  (b:vec3) :<50 -> vec3 = vec3(a.x + b.x, a.y + b.y, a.z + b.z)
(a:vec3) "-"  (b:vec3) :<50 -> vec3 = vec3(a.x - b.x, a.y - b.y, a.z - b.z)
(s:real) "*"  (v:vec3) :<60 -> vec3 = vec3(s * v.x, s * v.y, s * v.z)
(v:vec3) "*"  (s:real) :<60 -> vec3 = vec3(v.x * s, v.y * s, v.z * s)
(a:vec3) "**" (b:vec3) :<20 -> real = a.x * b.x + a.y * b.y + a.z * b.z

"dot3"(a:vec3, b:vec3)   -> real = a ** b
"cross3"(a:vec3, b:vec3) -> vec3 =
    vec3(a.y * b.z - a.z * b.y,
         a.z * b.x - a.x * b.z,
         a.x * b.y - a.y * b.x)
"vec3_mag"(v:vec3)          -> real = hypot(hypot(v.x, v.y), v.z)
"vec3_dist"(a:vec3, b:vec3) -> real = vec3_mag(b - a)
"lerp"(a:real, b:real, t:real) -> real = a + (b - a) * t

# Total 3D trajectory path length across a dynamic `vec<vec3>` of waypoints
"vec3_path_len"(pts:vec) -> real = (
    total := 0;
    idx   := 1;
    n     := len(pts);
    (idx < n) ?? (
        total = total + vec3_dist(at(pts, idx - 1), at(pts, idx));
        idx   = idx + 1
    );
    total
)

# 4. Circle & Sphere Geometry
"move_circle"(c:circle, dx:real, dy:real) -> circle = (
    c.center.x = c.center.x + dx;
    c.center.y = c.center.y + dy;
    c
)

"circle_area"(c:circle) -> real = π * c.radius^2
"circle_circum"(c:circle) -> real = 2 * π * c.radius
"sphere_vol"(r:real)    -> real = (4 / 3) * π * (r ^ 3)
"sphere_area"(r:real)   -> real = 4 * π * (r ^ 2)
