# =============================================================================
# Library/50_algebra.math — Matrices, Linear Systems, Quadratics & Polynomials
# =============================================================================

[algebra]
<[arith]
<[trig]
<[complex_ext]
<[geom_ext]

# 1. 2x2 Matrix Struct (`$mat2`: row-major [a, b; c, d])
$mat2(a:real, b:real, c:real, d:real)

(m1:mat2) "+" (m2:mat2) :<50 -> mat2 =
    mat2(m1.a + m2.a, m1.b + m2.b, m1.c + m2.c, m1.d + m2.d)

(m1:mat2) "-" (m2:mat2) :<50 -> mat2 =
    mat2(m1.a - m2.a, m1.b - m2.b, m1.c - m2.c, m1.d - m2.d)

(m1:mat2) "*" (m2:mat2) :<60 -> mat2 =
    mat2(m1.a * m2.a + m1.b * m2.c, m1.a * m2.b + m1.b * m2.d,
         m1.c * m2.a + m1.d * m2.c, m1.c * m2.b + m1.d * m2.d)

(m:mat2) "*" (v:vec2) :<60 -> vec2 =
    vec2(m.a * v.x + m.b * v.y, m.c * v.x + m.d * v.y)

(s:real) "*" (m:mat2) :<60 -> mat2 =
    mat2(s * m.a, s * m.b, s * m.c, s * m.d)

"det"(m:mat2)   -> real = m.a * m.d - m.b * m.c
"trace"(m:mat2) -> real = m.a + m.d
"transpose"(m:mat2) -> mat2 = mat2(m.a, m.c, m.b, m.d)

"inv_mat2"(m:mat2) -> mat2 = (
    d := det(m);
    mat2(m.d / d, -m.b / d, -m.c / d, m.a / d)
)

# 2. 2x2 Linear Equation System Solver (Cramer's Rule)
#    Solves: a1*x + b1*y = c1,  a2*x + b2*y = c2  -> returns vec2(x, y)
"solve_2x2"(a1:real, b1:real, c1:real, a2:real, b2:real, c2:real) -> vec2 = (
    d  := a1 * b2 - b1 * a2;
    dx := c1 * b2 - b1 * c2;
    dy := a1 * c2 - c1 * a2;
    vec2(dx / d, dy / d)
)

# 3. Quadratic Equation Solvers (`a*x^2 + b*x + c = 0`)
"quad_disc"(a:real, b:real, c:real) -> real = b^2 - 4 * a * c

# Real roots `vec2(r1, r2)` when discriminant >= 0
"quad_roots"(a:real, b:real, c:real) -> vec2 = (
    sd := √(b^2 - 4 * a * c);
    vec2((-b + sd) / (2 * a), (-b - sd) / (2 * a))
)

# Principal root in `$complex` (handles both real and complex roots when disc < 0!)
"quad_croot"(a:real, b:real, c:real) -> complex = (
    d := b^2 - 4 * a * c;
    if(d >= 0,
       complex((-b + √(d)) / (2 * a), 0),
       complex(-b / (2 * a), √(-d) / (2 * a)))
)

# 4. Symbolic & Numerical Polynomial Algebra on `$vec`
#    Polynomial `P(x) = c_0 + c_1*x + c_2*x^2 + ... + c_n*x^n` stored as `[c_0, c_1, ..., c_n]`

# 4a. Horner's Method Evaluation `poly_val(coeffs, x)` in O(n) operations
"poly_val"(coeffs:vec, x:real) -> real = (
    n   := len(coeffs);
    acc := 0;
    idx := n - 1;
    (idx >= 0) ?? (
        acc = acc * x + at(coeffs, idx);
        idx = idx - 1
    );
    acc
)

# 4b. Symbolic Polynomial Derivative `poly_deriv([c0, c1, c2, c3])` -> `[c1, 2*c2, 3*c3]`
"poly_deriv"(coeffs:vec) -> vec = (
    n   := len(coeffs);
    out := vec();
    if(n <= 1,
       push(out, 0),
       (
           idx := 1;
           (idx < n) ?? (
               push(out, idx * at(coeffs, idx));
               idx = idx + 1
           )
       )
    );
    out
)

# 4c. Symbolic Polynomial Indefinite Integral `poly_integ(coeffs, c0)`
"poly_integ"(coeffs:vec, c0:real) -> vec = (
    n   := len(coeffs);
    out := vec();
    push(out, c0);
    idx := 0;
    (idx < n) ?? (
        push(out, at(coeffs, idx) / (idx + 1));
        idx = idx + 1
    );
    out
)

# 4d. Symbolic Polynomial Addition `poly_add(p, q)`
"poly_add"(p:vec, q:vec) -> vec = (
    np  := len(p);
    nq  := len(q);
    n   := max(np, nq);
    out := vec();
    idx := 0;
    (idx < n) ?? (
        vp  := if(idx < np, at(p, idx), 0);
        vq  := if(idx < nq, at(q, idx), 0);
        push(out, vp + vq);
        idx = idx + 1
    );
    out
)

# 4e. Symbolic Polynomial Multiplication (Cauchy Convolution) `poly_mul(p, q)`
"poly_mul"(p:vec, q:vec) -> vec = (
    np  := len(p);
    nq  := len(q);
    deg := np + nq - 1;
    out := vec(deg, 0);
    ip  := 0;
    (ip < np) ?? (
        iq := 0;
        (iq < nq) ?? (
            k := ip + iq;
            set(out, k, at(out, k) + at(p, ip) * at(q, iq));
            iq = iq + 1
        );
        ip = ip + 1
    );
    out
)

# 4f. Newton-Raphson Polynomial Root Solver `poly_newton(coeffs, x0, steps)`
"poly_newton"(coeffs:vec, x0:real, steps:real) -> real = (
    dp  := poly_deriv(coeffs);
    x   := x0;
    k   := 0;
    (k < steps) ?? (
        fx  := poly_val(coeffs, x);
        dfx := poly_val(dp, x);
        x   = x - fx / dfx;
        k   = k + 1
    );
    x
)

# 5. Multidimensional Matrix Data Type (`$mat` via `[...]` Literals)
#    Supports 1D `[1, 2, 3]`, 2D `[[1, 2], [3, 4]]` or `[1, 2 ; 3, 4]`,
#    3D `[[[1, 2], [3, 4]], [[5, 6], [7, 8]]]`, and C-style subscripting `M[r, c]` / `M[r][c]`.
"-" (m:mat, T)            :80  -> mat, T = @mscal(m, -1)
(a:mat, T) "+" (b:mat, T) :<50 -> mat, T = @madd(a, b)
(a:mat, T) "-" (b:mat, T) :<50 -> mat, T = @msub(a, b)
(a:mat)    "*" (b:mat)    :<60 -> mat    = @mmul(a, b)
(m:mat, T) "*" (s:real)   :<60 -> mat, T = @mscal(m, s)
(s:real)   "*" (m:mat, T) :<60 -> mat, T = @mscal(m, s)
(m:mat, T) "/" (s:real)   :<60 -> mat, T = @mscal(m, 1 / s)

"mat_zeros"(r:real, c:real)           -> mat     = @mzero(r, c)
"mat_ones"(r:real, c:real)            -> mat     = @mones(r, c)
"mat_eye"(n:real)                     -> mat     = @meye(n)
"mat_fill"(r:real, c:real, v:real, T) -> mat, T  = @mfill(r, c, v)
"mat_rows"(m:mat)                     -> real    = @mrows(m)
"mat_cols"(m:mat)                     -> real    = @mcols(m)
"mat_rank"(m:mat)                     -> real    = @mrank(m)
"mat_len"(m:mat)                      -> real    = @mlen(m)
"mat_shape"(m:mat)                    -> vec     = @mshape(m)
"transpose"(m:mat, T)                 -> mat, T  = @mtrans(m)
"trace"(m:mat, T)                     -> real, T = @mtrace(m)
"det"(m:mat)                          -> real    = @mdet(m)
"inv"(m:mat)                          -> mat     = @minv(m)
