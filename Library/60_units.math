# =============================================================================
# Library/60_units.math — SI & Imperial Unit Conversions & Postfix Suffixes
# =============================================================================
# All postfix unit operators normalize values to SI base units:
#   - Angle      -> radians (rad)
#   - Length     -> meters (m)
#   - Mass       -> kilograms (kg)
#   - Time       -> seconds (s)
#   - Speed      -> meters per second (m/s)
#   - Pressure   -> Pascals (Pa)
#   - Energy     -> Joules (J)
#   - Power      -> Watts (W)

[units]
<[arith]
<[trig]

# 1. Angle, Percentage & Decibel Postfix Operators
(d:real) "deg"    :95 -> real = d * π / 180
(d:real) "°"      :95 -> real = d * π / 180
(m:real) "arcmin" :95 -> real = m * π / (180 * 60)
(s:real) "arcsec" :95 -> real = s * π / (180 * 3600)
(x:real) "pct"    :95 -> real = x * 0.01
(x:real) "dB"     :95 -> real = 10 ^ (x / 20)
(x:real) "dBm"    :95 -> real = 0.001 * (10 ^ (x / 10))

"deg2rad"(deg:real) -> real = deg * π / 180
"rad2deg"(rad:real) -> real = rad * 180 / π

# 2. Length Postfix Operators (Normalized to SI Meters `m`)
(x:real) "km"   :95 -> real = x * 1000
(x:real) "cm"   :95 -> real = x * 0.01
(x:real) "mm"   :95 -> real = x * 0.001
(x:real) "um"   :95 -> real = x * (10 ^ -6)
(x:real) "nm"   :95 -> real = x * (10 ^ -9)
(x:real) "mi"   :95 -> real = x * 1609.344
(x:real) "nmi"  :95 -> real = x * 1852
(x:real) "yd"   :95 -> real = x * 0.9144
(x:real) "ft"   :95 -> real = x * 0.3048
(x:real) "inch" :95 -> real = x * 0.0254

"m_to_km"(m:real)   -> real = m / 1000
"m_to_ft"(m:real)   -> real = m / 0.3048
"m_to_mi"(m:real)   -> real = m / 1609.344
"ft_to_m"(ft_v:real)-> real = ft_v * 0.3048
"in_to_cm"(in_v:real)-> real = in_v * 2.54
"cm_to_in"(cm_v:real)-> real = cm_v / 2.54

# 3. Mass Postfix Operators (Normalized to SI Kilograms `kg`)
(x:real) "kg"   :95 -> real = x
(x:real) "gram" :95 -> real = x * 0.001
(x:real) "mg"   :95 -> real = x * (10 ^ -6)
(x:real) "ton"  :95 -> real = x * 1000
(x:real) "lb"   :95 -> real = x * 0.45359237
(x:real) "oz"   :95 -> real = x * 0.028349523125
(x:real) "amu"  :95 -> real = x * 1.66053906660 * (10 ^ -27)

"kg_to_lb"(kg_v:real) -> real = kg_v / 0.45359237
"lb_to_kg"(lb_v:real) -> real = lb_v * 0.45359237

# 4. Time Postfix Operators (Normalized to SI Seconds `s`)
(x:real) "ms"    :95 -> real = x * 0.001
(x:real) "us"    :95 -> real = x * (10 ^ -6)
(x:real) "ns"    :95 -> real = x * (10 ^ -9)
(x:real) "sec"   :95 -> real = x
(x:real) "min_t" :95 -> real = x * 60
(x:real) "hr"    :95 -> real = x * 3600
(x:real) "day"   :95 -> real = x * 86400

# 5. Speed Postfix Operators (Normalized to SI `m/s`)
(x:real) "kph"   :95 -> real = x / 3.6
(x:real) "mph"   :95 -> real = x * 0.44704
(x:real) "knots" :95 -> real = x * (1852 / 3600)

"mps_to_kph"(v:real) -> real = v * 3.6
"mps_to_mph"(v:real) -> real = v / 0.44704

# 6. Pressure Postfix Operators (Normalized to SI Pascals `Pa`)
(x:real) "kPa"  :95 -> real = x * 1000
(x:real) "MPa"  :95 -> real = x * 1000000
(x:real) "bar"  :95 -> real = x * 100000
(x:real) "atm"  :95 -> real = x * 101325
(x:real) "psi"  :95 -> real = x * 6894.757293168
(x:real) "torr" :95 -> real = x * (101325 / 760)

# 7. Energy & Power Postfix Operators (Normalized to SI Joules `J` & Watts `W`)
(x:real) "kJ"   :95 -> real = x * 1000
(x:real) "MJ"   :95 -> real = x * 1000000
(x:real) "cal"  :95 -> real = x * 4.184
(x:real) "kcal" :95 -> real = x * 4184
(x:real) "Wh"   :95 -> real = x * 3600
(x:real) "kWh"  :95 -> real = x * 3600000
(x:real) "eV"   :95 -> real = x * 1.602176634 * (10 ^ -19)
(x:real) "kW"   :95 -> real = x * 1000
(x:real) "MW"   :95 -> real = x * 1000000
(x:real) "hp"   :95 -> real = x * 745.699872

# 8. Temperature Conversions (Affine Scales: Celsius, Fahrenheit, Kelvin)
"c_to_k"(c:real) -> real = c + 273.15
"k_to_c"(k:real) -> real = k - 273.15
"c_to_f"(c:real) -> real = c * 1.8 + 32
"f_to_c"(f:real) -> real = (f - 32) / 1.8
"f_to_k"(f:real) -> real = (f - 32) / 1.8 + 273.15
"k_to_f"(k:real) -> real = (k - 273.15) * 1.8 + 32
