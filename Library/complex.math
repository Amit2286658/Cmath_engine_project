# =============================================================================
# Library/complex.math — Postfix `i` ($iota) Operator & Complex Operations
# =============================================================================

[complex_ext]
<[arith]
<[trig]

# Non-consuming struct type (fields default to :real)
$complex(re, im)

# Postfix imaginary operator `i` (precedence 95: binds tighter than `^`, `*`, `-`)
# Preserves any unit tag `T` on `x` (so `(50m)i` has type `iota` and unit `distance`!)
(x:real, T)    i :95 -> iota, T    = @raw(x)
(x:iota, T)    i :95 -> real, T    = -@raw(x)
(z:complex, T) i :95 -> complex, T = complex(-z.im, z.re)

# Unary & binary arithmetic on `iota` (generic over unit `T`)
"-" (a:iota, T)             :80  -> iota, T = @neg(a)
(a:iota, T) "+"  (b:iota, T):<50 -> iota, T = @add(a, b)
(a:iota, T) "-"  (b:iota, T):<50 -> iota, T = @sub(a, b)
(a:iota, T) into (b:iota, T):>55 -> iota, T = @add(a, b)
(a:iota)    "*"  (b:iota)   :<60            = -(@mul(a, b))
(a)         "*"  (b:iota)   :<60 -> iota    = @mul(a, b)
(a:iota)    "*"  (b)        :<60 -> iota    = @mul(a, b)

# Constructing `complex` from `real` and `iota` (propagates matching unit `T`)
(a:real, T)    "+" (b:iota, T)    :<50 -> complex, T = complex(a, @raw(b))
(a:real, T)    "-" (b:iota, T)    :<50 -> complex, T = complex(a, -@raw(b))
(a:iota, T)    "+" (b:real, T)    :<50 -> complex, T = complex(b, @raw(a))
(a:iota, T)    "-" (b:real, T)    :<50 -> complex, T = complex(-b, @raw(a))
(z:complex, T) "+" (b:iota, T)    :<50 -> complex, T = complex(z.re, z.im + @raw(b))
(z:complex, T) "-" (b:iota, T)    :<50 -> complex, T = complex(z.re, z.im - @raw(b))
(z:complex, T) "+" (b:real, T)    :<50 -> complex, T = complex(z.re + b, z.im)
(z:complex, T) "-" (b:real, T)    :<50 -> complex, T = complex(z.re - b, z.im)
(a:real, T)    "+" (z:complex, T) :<50 -> complex, T = complex(a + z.re, z.im)

# Insert / Composition Operator `into`:
#   - Cross-entity (`real` + `iota`) constructs `complex` (`5 into 5i` -> `5 + 5i`)
#   - Component into `complex` adds that component (`2 into (3 + 4i)` -> `5 + 4i`)
#   - Likewise `complex into complex` sums them (`(1 + 2i) into (3 + 4i)` -> `4 + 6i`)
(a:real, T)    into (b:iota, T)    :>55 -> complex, T = complex(a, @raw(b))
(a:iota, T)    into (b:real, T)    :>55 -> complex, T = complex(b, @raw(a))
(a:real, T)    into (z:complex, T) :>55 -> complex, T = complex(z.re + a, z.im)
(a:iota, T)    into (z:complex, T) :>55 -> complex, T = complex(z.re, z.im + @raw(a))
(a:complex, T) into (b:complex, T) :>55 -> complex, T = complex(a.re + b.re, a.im + b.im)

# Overloaded arithmetic on `complex` numbers
(a:complex, T) "+" (b:complex, T) :<50 -> complex, T = complex(a.re + b.re, a.im + b.im)
(a:complex, T) "-" (b:complex, T) :<50 -> complex, T = complex(a.re - b.re, a.im - b.im)
(a:complex)    "*" (b:complex)    :<60 -> complex    =
    complex(a.re * b.re - a.im * b.im, a.re * b.im + a.im * b.re)
(a:complex)    "/" (b:complex)    :<60 -> complex    = {
    denom := b.re^2 + b.im^2
    complex((a.re * b.re + a.im * b.im) / denom,
            (a.im * b.re - a.re * b.im) / denom)
}

conj(z:complex, T)      -> complex, T = complex(z.re, -z.im)
cabs(z:complex, T)      -> real, T    = √(z.re^2 + z.im^2)
carg(z:complex)                       = atan2(z.im, z.re)
cexp_i(theta)           -> complex    = complex(cos(theta), sin(theta))
polar(r:real, T, theta) -> complex, T = complex(r * cos(theta), r * sin(theta))

# Equality and Approximate Equality (`~`) for complex numbers
(a:complex, T) "==" (b:complex, T) :<30 = (a.re == b.re) && (a.im == b.im)
(a:complex, T) "!=" (b:complex, T) :<30 = (a.re != b.re) || (a.im != b.im)
(a:complex, T) "~"  (b:complex, T) :<30 = (a.re ~ b.re) && (a.im ~ b.im)
